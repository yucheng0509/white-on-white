# --- 金鑰（勿進版控，.gitignore 已排除 .env）---
# 必填。取得處：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 選填。有這把才能把 Claude 納入受測模型或當生成器
ANTHROPIC_API_KEY=

# --- 模型 ---
# 工具用模型：注入樣本生成、風險對應、注入定位
GENERATOR_MODEL=gemini-3.8-flash

# 受測模型清單，逗號分隔。這些是「實驗對象」，應填組織實際會用的模型。
# 預設橫跨三個世代，用來看「新版是否比較抗操控」。
TARGET_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

# --- 成本閘門（美元）---
# 建立批次時事前估算，超過即拒絕。多步配置會自動加權。
MAX_RUN_USD=5.0
MAX_DAILY_USD=10.0

# --- 其他 ---
DRILL_DB=data/drill.db
# 單次模型呼叫的逾時秒數。沒有逾時的批次會在某一格無聲卡死。
DRILL_CALL_TIMEOUT=120
# 批次執行的並行度。免費層 RPM 有限，調高容易撞 429。
DRILL_WORKERS=4
